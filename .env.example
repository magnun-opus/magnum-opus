# Magnum Opus's own event-log database.
# On Windows the default superuser is "postgres", not your Windows username,
# and it almost always has a password. Set both explicitly:
#   MAGNUM_OPUS_DB_URL=postgres://postgres:YOURPASSWORD@127.0.0.1:5432/magnum_opus
MAGNUM_OPUS_DB_URL=postgres://postgres@127.0.0.1:5432/magnum_opus

# The sample app's database (only needed for the included demo app).
SAMPLE_APP_DB_URL=postgres://postgres@127.0.0.1:5432/magnum_opus_sample

# Use 127.0.0.1 rather than localhost. On Windows, localhost resolves to both
# ::1 and 127.0.0.1; Postgres usually listens on IPv4 only, so the IPv6
# attempt fails first. Magnum Opus rewrites localhost to 127.0.0.1 for you.
# Set this to 1 if you actually need the IPv6 loopback.
MAGNUM_OPUS_ALLOW_LOCALHOST=

# Set to 1 to run the sample app in its FIXED state (honours Idempotency-Key).
# Leave unset for the buggy default that the detectors are meant to catch.
SAMPLE_APP_FIXED=

# Seed for the sample app's latency injection, so demo runs are reproducible.
SAMPLE_APP_SEED=demo

# Where the simulation should point. Overrides baseUrl in the config file, so
# you never have to edit JSON to change a port. Handy if Postgres occupies
# the sample app's default 4000 — then run the app with PORT=4100 and set:
#   MAGNUM_TARGET_URL=http://localhost:4100
MAGNUM_TARGET_URL=

# Port for the bundled sample app (default 4000).
PORT=
