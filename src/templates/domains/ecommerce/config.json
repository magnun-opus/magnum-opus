{
  "baseUrl": "http://localhost:3000",
  "personasDir": "./personas",
  "_domain": "ecommerce",
  "_description": "Storefront: browse, cart, checkout. Inventory and order uniqueness.",
  "concurrency": 25,
  "personaMix": {
    "shopper": 40,
    "bulk_buyer": 10
  },
  "idempotency": {
    "enabled": true
  },
  "failOn": "critical",
  "allowedHosts": [],
  "detectors": {
    "isolation": {
      "enabled": true
    },
    "invariantViolations": {
      "enabled": true
    },
    "errorSpikes": {
      "warnAt": 0.15,
      "criticalAt": 0.3
    },
    "abandonmentRate": {
      "threshold": 0.35
    }
  }
}