{
  "baseUrl": "http://localhost:3000",
  "personasDir": "./personas",
  "_domain": "saas",
  "_description": "Multi-tenant SaaS: signup, org creation, invites, plan changes. Tenant isolation is the headline risk.",
  "concurrency": 20,
  "personaMix": {
    "trial_user": 30,
    "org_admin": 15
  },
  "idempotency": {
    "enabled": true
  },
  "failOn": "critical",
  "allowedHosts": [],
  "detectors": {
    "isolation": {
      "enabled": true
    },
    "invariantViolations": {
      "enabled": true
    },
    "errorSpikes": {
      "warnAt": 0.15,
      "criticalAt": 0.3
    },
    "abandonmentRate": {
      "threshold": 0.35
    }
  }
}