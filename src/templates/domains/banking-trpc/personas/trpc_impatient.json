{
  "persona": "trpc_impatient",
  "protocol": "trpc",
  "trpc": {
    "prefix": "/api/trpc",
    "transformer": "superjson"
  },
  "patience_ms": 800,
  "probes": {
    "ledger": {
      "procedure": "banking.ledger",
      "type": "query",
      "input": {
        "owner": "{{actor.sessionId}}"
      }
    }
  },
  "invariants": [
    {
      "name": "no double spend under retry",
      "type": "unique",
      "collection": "ledger.entries",
      "field": "reference"
    },
    {
      "name": "one transfer per intent",
      "type": "count",
      "collection": "ledger.entries",
      "atMost": {
        "intents": "transfer"
      }
    }
  ],
  "states": [
    {
      "name": "transfer",
      "on_enter": {
        "event_type": "trpc",
        "procedure": "banking.transfer",
        "type": "mutation",
        "intent": "transfer",
        "input": {
          "owner": "{{actor.sessionId}}",
          "amount": 5000,
          "reference": "fast-{{actor.sessionId}}"
        }
      },
      "transitions": [
        {
          "to": "done",
          "condition": "on_success"
        },
        {
          "to": "wait",
          "condition": "on_timeout"
        },
        {
          "to": "give_up",
          "condition": "on_error"
        }
      ]
    },
    {
      "name": "wait",
      "on_enter": {
        "event_type": "wait",
        "duration_ms": 500
      },
      "transitions": [
        {
          "to": "done",
          "condition": "response_received_within_wait"
        },
        {
          "to": "retry",
          "condition": "no_response_after_wait",
          "probability": 0.95
        },
        {
          "to": "give_up",
          "condition": "no_response_after_wait",
          "probability": 0.05
        }
      ]
    },
    {
      "name": "retry",
      "on_enter": {
        "event_type": "trpc",
        "procedure": "banking.transfer",
        "type": "mutation",
        "intent": "transfer",
        "tags": [
          "retry"
        ],
        "input": {
          "owner": "{{actor.sessionId}}",
          "amount": 5000,
          "reference": "fast-{{actor.sessionId}}"
        }
      },
      "transitions": [
        {
          "to": "done",
          "condition": "on_success"
        },
        {
          "to": "give_up",
          "condition": "on_timeout"
        },
        {
          "to": "give_up",
          "condition": "on_error"
        }
      ]
    },
    {
      "name": "done",
      "terminal": true,
      "outcome_class": "success"
    },
    {
      "name": "give_up",
      "terminal": true,
      "outcome_class": "abandon"
    }
  ]
}