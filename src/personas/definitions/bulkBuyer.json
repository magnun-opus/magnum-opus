{
  "persona": "bulk_buyer",
  "patience_ms": 4000,
  "variables": {
    "productId": { "choice": [1, 2, 3] },
    "quantity": { "range": [5, 20] }
  },
  "verification": {
    "action": "GET /orders?sessionId={{actor.sessionId}}",
    "collection": "orders",
    "expect": "one_per_successful_intent"
  },
  "states": [
    {
      "name": "view_product",
      "on_enter": {
        "event_type": "http_request",
        "action": "GET /products/{{vars.productId}}"
      },
      "transitions": [{ "to": "add_to_cart_1", "condition": "always" }]
    },
    {
      "name": "add_to_cart_1",
      "on_enter": {
        "event_type": "http_request",
        "action": "POST /cart",
        "body": {
          "sessionId": "{{actor.sessionId}}",
          "productId": "{{vars.productId}}",
          "quantity": "{{vars.quantity}}"
        }
      },
      "think_ms": [200, 600],
      "transitions": [
        { "to": "add_to_cart_2", "condition": "on_success" },
        { "to": "abandon", "condition": "on_error" },
        { "to": "abandon", "condition": "on_timeout" }
      ]
    },
    {
      "name": "add_to_cart_2",
      "on_enter": {
        "event_type": "http_request",
        "action": "POST /cart",
        "body": {
          "sessionId": "{{actor.sessionId}}",
          "productId": "{{vars.productId}}",
          "quantity": "{{vars.quantity}}"
        }
      },
      "transitions": [
        { "to": "checkout", "condition": "on_success" },
        { "to": "abandon", "condition": "on_error" },
        { "to": "abandon", "condition": "on_timeout" }
      ]
    },
    {
      "name": "checkout",
      "on_enter": {
        "event_type": "http_request",
        "action": "POST /checkout",
        "intent": "checkout",
        "body": { "sessionId": "{{actor.sessionId}}" },
        "extract": { "orderId": "orderId" }
      },
      "transitions": [
        { "to": "checkout_success", "condition": "on_success" },
        { "to": "abandon", "condition": "on_timeout" },
        { "to": "abandon", "condition": "on_error" }
      ]
    },
    { "name": "checkout_success", "terminal": true, "outcome_class": "success" },
    { "name": "abandon", "terminal": true, "outcome_class": "abandon" }
  ]
}
